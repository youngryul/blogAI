# ---------------------------------------------------------------
# Supabase (필수) — Project Settings > API
# ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# 서버 전용. 절대 클라이언트에 노출하지 마세요. (현재는 선택적 보조 기능용)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------
# OpenAI — 비워 두면 Mock Mode(샘플 결과)로 동작합니다.
# ---------------------------------------------------------------
OPENAI_API_KEY=
# 선택: 모델/품질 설정
OPENAI_TEXT_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-1-mini
# low | medium | high
OPENAI_IMAGE_QUALITY=medium
# 선택: reasoning 모델의 추론 강도 (low | medium | high). 기본 low
# OPENAI_REASONING_EFFORT=low

# 키가 있어도 강제로 Mock Mode 로 동작시키려면 true
AI_MOCK_MODE=false

# ---------------------------------------------------------------
# (향후) 키워드 데이터 provider — 네이버 검색광고 API
# ---------------------------------------------------------------
# KEYWORD_PROVIDER=naver
# NAVER_SEARCHAD_API_KEY=
# NAVER_SEARCHAD_SECRET=
# NAVER_SEARCHAD_CUSTOMER_ID=
